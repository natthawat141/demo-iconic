# OpenRouter is optional. Without these values the app runs in deterministic demo mode.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Set true for predictable sales demos even when a key is present.
DEMO_SAFE_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
