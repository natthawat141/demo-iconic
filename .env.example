# OpenRouter is optional. Without these values the app runs in deterministic demo mode.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
# Optional: use a dedicated vision-capable model for image messages.
OPENROUTER_VISION_MODEL=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Set true only when you intentionally want deterministic demo responses.
DEMO_SAFE_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Preferred production storage. Connect through Cloud SQL Auth Proxy locally.
# POSTGRES_URL=postgresql://iconic_app:password@127.0.0.1:5433/iconic_knowledge
POSTGRES_URL=

# Optional Oracle MySQL storage. Leave empty to use local SQLite.
# MYSQL_URL=mysql://user:password@host:3306/iconic_knowledge?ssl=true
MYSQL_URL=

# Demo file bucket. The application keeps binary uploads in Cloud Storage, not PostgreSQL.
GCS_UPLOAD_BUCKET=aione-zone1-iconic-demo-50194055876
# Local-only fallback when Application Default Credentials are not configured.
# Never enable this in Cloud Run; its service account supplies Application Default Credentials.
GCS_USE_GCLOUD_USER_AUTH=false
